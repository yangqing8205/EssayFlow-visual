# EssayFlow 环境变量示例
# 复制为 .env.local 后填写。.env* 已被 .gitignore 忽略，切勿提交真实 Key。

# 必需：OpenAI 兼容接口的 API Key。仅服务端读取，不会下发到浏览器。
# 未配置时，真实评测会返回明确错误（HTTP 503），不会退回脱敏示例报告。
OPENAI_API_KEY=

# DeepSeek 的 OpenAI 兼容地址。切换其他提供商时可替换。
OPENAI_BASE_URL=https://api.deepseek.com

# 留空时默认 deepseek-v4-flash。四阶段评测需要稳定遵循 JSON 输出要求。
OPENAI_MODEL=deepseek-v4-flash

# 部署版必需：静态网页提交评测时使用的 Beta 访问码。
EVALUATION_ACCESS_CODE=

# 部署版必需：允许调用评测接口的网页来源，多个来源用英文逗号分隔。
ESSAYFLOW_ALLOWED_ORIGINS=http://127.0.0.1:4174,https://essayflow-demo.yangqing8205.chatgpt.site

# 每个 IP 每小时最多评测次数。内存计数适合当前低流量 Beta。
EVALUATION_RATE_LIMIT_PER_HOUR=10
